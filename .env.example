
# =====================================================

# بيانات قاعدة البيانات (من cPanel > MySQL Databases)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# مفتاح OpenAI (من https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# إعدادات عامة
APP_NAME=نظام المحاسبة الذكي
APP_TIMEZONE=
APP_CURRENCY=

# اجعلها false بعد ما تتأكد كل شيء شغال تمام على السيرفر الفعلي
DEBUG_MODE=false

NOTIFY_EMAIL=
APP_URL=

# ============================================
# إعدادات بوت واتساب (WhatsApp Cloud API - Meta)
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_PHONE=

POS_API_BASE_URL=
POS_API_KEY=

# كم يوم للوراء تجيب المزامنة اليومية العادية (كرون الموردين/العملاء) - مش المزامنة
# التاريخية الكاملة. خليها 5 بدل 1 كهامش أمان: لو الكرون فشل يشتغل يوم أو يومين
# (السيرفر وقع، rate limit، الخ)، ما بتفوتك حركات - وإعادة سحب أيام سابقة آمنة
# 100% بسبب الـ UNIQUE KEY على الحركات (ما بتتكرر، بس بتتحدث لو تغيّرت).
POS_SYNC_DAYS_BACK=