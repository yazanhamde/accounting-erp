# =====================================================
# انسخ هذا الملف وسمّه ".env" (بدون .example) وعبّي بياناتك الحقيقية فيه
# ملف .env الحقيقي ما لازم يترفع لأي مكان عام (Git عام مثلاً)
# =====================================================

# بيانات قاعدة البيانات (من cPanel > MySQL Databases)
DB_HOST=localhost
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# مفتاح OpenAI (من https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# إعدادات عامة
APP_NAME=نظام المحاسبة الذكي
APP_TIMEZONE=Asia/Amman
APP_CURRENCY=JOD

# اجعلها false بعد ما تتأكد كل شيء شغال تمام على السيرفر الفعلي
DEBUG_MODE=false

NOTIFY_EMAIL=owner@example.com
APP_URL=https://yourdomain.com

# ============================================
# إعدادات بوت واتساب (WhatsApp Cloud API - Meta)
# ============================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose_any_random_string
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_PHONE=962XXXXXXXXX

POS_API_BASE_URL=https://your-pos.example.com
POS_API_KEY=your_pos_api_key

# كم يوم للوراء تجيب المزامنة اليومية العادية (كرون الموردين/العملاء) - مش المزامنة
POS_SYNC_DAYS_BACK=2
CUSTOMER_LEDGER_BATCH_SIZE=14
SUPPLIER_LEDGER_BATCH_SIZE=28
CRON_SECRET=generate_a_long_random_string
